# Windows/development configuration only. Copy to .env and replace placeholders.
HA_URL=YOUR_HA_URL
HA_TOKEN=YOUR_TOKEN
TIMEZONE=Australia/Brisbane
DATABASE_URL=postgresql+psycopg://energy_dev:YOUR_DB_PASSWORD@YOUR_NAS_HOST:55432/home_energy_dev
COLLECTION_INTERVAL_SECONDS=300

# Use this instead of PostgreSQL only for offline/local compatibility:
# DATABASE_URL=sqlite:///data/energy_history.db

GRID_POWER_SIGN=unknown
BATTERY_POWER_SIGN=unknown
SIGN_CONVENTION_CONFIDENCE=unconfirmed
SIGN_CONVENTION_SUPPORTING_SAMPLES=0

# Optional read-only vehicle telemetry. Entity IDs vary by installation.
EV_VEHICLE_ENABLED=false
EV_CHARGING_ENTITY=
EV_PLUGGED_ENTITY=
EV_ONLINE_ENTITY=
EV_SOC_ENTITY=
EV_BATTERY_POWER_ENTITY=
EV_TELEMETRY_UPDATED_ENTITY=
EV_LOCATION_ENTITY=
EV_HOME_STATE=home
EV_TELEMETRY_STALE_SECONDS=900
