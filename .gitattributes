# Auto detect text files and perform LF normalization
* text=auto

# Release byte identity and canonical App bootstrap on every host
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
